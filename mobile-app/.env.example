EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
# Public HTTPS URL of the CRM/backend itself (for Oracle/Tailscale this is https://YOUR-TAILSCALE-NAME.ts.net).
# Do not use the Supabase URL here, and do not append /api.
EXPO_PUBLIC_BOT_API_URL=https://YOUR_CRM_BACKEND
# Optional before EAS init. EAS builds normally expose their project id automatically.
EXPO_PUBLIC_EAS_PROJECT_ID=
