SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=SERVER_ONLY_SERVICE_ROLE_KEY
DASHBOARD_ORIGIN=http://localhost:5173
PORT=3001
SESSION_PATH=./sessions
# Production Docker image sets the following automatically:
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# Meta Marketing API / Facebook Login (server-only)
# Create a Meta app with Marketing API + Facebook Login, then whitelist the callback URI below.
META_APP_ID=YOUR_META_APP_ID
META_APP_SECRET=YOUR_META_APP_SECRET
# Use a long random secret (32+ chars). Changing it later requires reconnecting Meta accounts.
META_TOKEN_ENCRYPTION_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_32_CHARS_MIN
# Set this to the Graph API version enabled for your Meta app, e.g. vXX.X.
META_GRAPH_VERSION=vXX.X
# Must exactly match the Valid OAuth Redirect URI configured in Meta.
META_OAUTH_REDIRECT_URI=https://YOUR_CRM_BACKEND/integrations/meta/callback
